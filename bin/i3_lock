#!/usr/bin/env bash

icon="$HOME/Pictures/out.png"
tmpbg='/tmp/screen.png'

# (( $# )) && { icon=$1; }
# (( $# ))

scrot "$tmpbg"
convert "$tmpbg" -scale 10% -scale 1000% -fill black -colorize 70%  "$tmpbg"
# convert "$tmpbg" -scale 10% -scale 1000% -fill black -colorize 30%
convert "$tmpbg" "$icon" -gravity center -composite -matte "$tmpbg"
# i3lock -u -i "$tmpbg"
# -indpos="x+86:y+1003"
i3lock -n -i "$tmpbg"
