# i3 config for an HHKB / 60% keyboard workflow.
# If your HHKB diamond/meta key does not map to Super on Linux,
# change the next line to: set $mod Mod1
set $mod Mod4

font pango:monospace 8

# Session-local dark theme wrapper for apps launched from i3.
set $dark_exec /home/lbigas/.config/i3/scripts/run-with-dark-env.sh

focus_follows_mouse no
mouse_warping none
workspace_auto_back_and_forth no
floating_modifier $mod
tiling_drag modifier titlebar

default_border pixel 2
default_floating_border pixel 2
gaps inner 7
gaps outer 1
smart_gaps on

client.focused          #9ccfd8 #191724 #e0def4 #9ccfd8 #9ccfd8
client.focused_inactive #26233a #191724 #908caa #26233a #26233a
client.unfocused        #26233a #191724 #908caa #26233a #26233a
client.urgent           #eb6f92 #191724 #e0def4 #eb6f92 #eb6f92

set $term $dark_exec wezterm start
set $launcher $dark_exec rofi -show drun -matching fuzzy -kb-cancel Escape
set $lock ~/.config/i3/scripts/lock.sh
set $power ~/.config/i3/scripts/power-menu.sh
set $network ~/.config/i3/scripts/network-menu.sh
set $bluetooth ~/.config/i3/scripts/bluetooth-menu.sh
set $audio ~/.config/i3/scripts/audio-menu.sh
set $brightness ~/.config/i3/scripts/brightness-control.sh

exec_always --no-startup-id /home/lbigas/.config/polybar/launch.sh
exec_always --no-startup-id ~/.config/i3/scripts/startup.sh

set $up k
set $down j
set $left h
set $right l

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+d exec --no-startup-id $launcher
bindsym $mod+Shift+q kill

bindsym $mod+Escape exec --no-startup-id $lock
bindsym $mod+Shift+Escape exec --no-startup-id $power
bindsym $mod+Ctrl+n exec --no-startup-id $network
bindsym $mod+Ctrl+b exec --no-startup-id $bluetooth
bindsym $mod+Ctrl+a exec --no-startup-id $audio
bindsym $mod+n exec --no-startup-id dunstctl close
bindsym $mod+Shift+n exec --no-startup-id dunstctl close-all
bindsym $mod+Ctrl+Shift+n exec --no-startup-id dunstctl history-pop
bindsym $mod+Ctrl+comma exec --no-startup-id $brightness --down
bindsym $mod+Ctrl+period exec --no-startup-id $brightness --up

bindsym $mod+comma exec --no-startup-id $audio --down
bindsym $mod+period exec --no-startup-id $audio --up
bindsym $mod+slash exec --no-startup-id $audio --mute

bindsym XF86MonBrightnessDown exec --no-startup-id $brightness --down
bindsym XF86MonBrightnessUp exec --no-startup-id $brightness --up
bindsym XF86AudioLowerVolume exec --no-startup-id $audio --down
bindsym XF86AudioRaiseVolume exec --no-startup-id $audio --up
bindsym XF86AudioMute exec --no-startup-id $audio --mute
bindsym XF86AudioMicMute exec --no-startup-id $audio --mic-mute
bindsym --release Print exec --no-startup-id flameshot gui -p /home/lbigas/Pictures/Screenshots
bindsym --release Shift+Print exec --no-startup-id flameshot gui -c
bindsym --release Ctrl+Print exec --no-startup-id flameshot full -p /home/lbigas/Pictures/Screenshots

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+ISO_Left_Tab workspace prev_on_output
bindsym $mod+grave workspace back_and_forth

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

mode "resize" {
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Built-in i3bar disabled in favor of Polybar.
