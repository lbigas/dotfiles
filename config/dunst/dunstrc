[global]
    monitor = 0
    follow = none
    origin = top-right
    offset = (16, 44)
    notification_limit = 6
    width = 360
    height = (0, 300)
    progress_bar = true
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 12
    separator_height = 2
    frame_width = 2
    corner_radius = 12
    font = JetBrains Mono NL 10
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    markup = full
    sort = yes
    idle_threshold = 120
    show_age_threshold = 60
    word_wrap = yes
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4
    background = "#191724"
    foreground = "#e0def4"
    frame_color = "#908caa"

[urgency_normal]
    timeout = 6
    background = "#191724"
    foreground = "#e0def4"
    frame_color = "#9ccfd8"

[urgency_critical]
    timeout = 0
    background = "#191724"
    foreground = "#e0def4"
    frame_color = "#eb6f92"

[discord]
    desktop_entry = com.discordapp.Discord
    set_transient = yes
    override_dbus_timeout = 6
